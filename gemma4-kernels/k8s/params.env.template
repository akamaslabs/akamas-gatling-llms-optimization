# Rendered by the Akamas FileConfigurator task into params.env, then sourced by
# apply_config.sh -> render_statefulset.sh, which validates every value and writes the vLLM
# flags. Every vllm token below must be in the study's parametersSelection
# (ignoreUnsubstitutedTokens false).
#
# Study 2 tunes the kernel backends and the scheduler knobs that size the batch around them
# (study 27's per-role set, one role here). The rest of study 30's base set is fixed at vLLM
# 0.29.0's defaults, so a difference between configurations comes from the kernels.
# auto = vLLM's own choice, which for this model on the L40S is (kernel probe, 2026-10-08):
#   MOE_BACKEND auto = TRITON, LINEAR_BACKEND auto = Cutlass, ATTENTION_BACKEND auto =
#   TRITON_ATTN (forced by Gemma4Config on SM 8.9).
GPU_MEMORY_UTILIZATION=${vllm.gpu_memory_utilization}
MAX_NUM_SEQS=${vllm.max_num_seqs}
MAX_NUM_BATCHED_TOKENS=${vllm.max_num_batched_tokens}
KV_CACHE_DTYPE=${vllm.kv_cache_dtype}
MOE_BACKEND=${vllm.moe_backend}
TUNED_MOE_CONFIGS=${vllm.tuned_kernel_configs}
LINEAR_BACKEND=${vllm.linear_backend}
ATTENTION_BACKEND=${vllm.attention_backend}
# Fixed (vLLM 0.29.0 defaults on a < 70 GB GPU, study 30's baseline).
PERFORMANCE_MODE=balanced
OPTIMIZATION_LEVEL=2
ENFORCE_EAGER=false
SCHEDULING_POLICY=fcfs
ASYNC_SCHEDULING=true
MAX_CUDAGRAPH_CAPTURE_SIZE=512
BLOCK_SIZE=16
